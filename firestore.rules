rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if request comes from an authenticated user
    function isSignedIn() {
      return request.auth != null && request.auth.token != null;
    }

    // Helper: Safely retrieve lowercase email from auth token
    function getUserEmail() {
      return (isSignedIn() && 'email' in request.auth.token && request.auth.token.email != null) 
        ? request.auth.token.email.toLowerCase() 
        : '';
    }

    // Helper: Check if request email matches the document owner
    function isOwner(email) {
      return isSignedIn() && getUserEmail() == email.toLowerCase();
    }

    // Helper: Check if user is a Master Admin or authorized Assistant listed in admin_users
    function isAdmin() {
      return isSignedIn() && (
        getUserEmail() == 'adityapatil.4132@gmail.com' ||
        getUserEmail() == 'admin@apex.edu' ||
        (getUserEmail() != '' && exists(/databases/$(database)/documents/admin_users/$(getUserEmail())))
      );
    }

    // -------------------------------------------------------------
    // 1. APPLICATIONS COLLECTION
    // -------------------------------------------------------------
    match /applications/{appId} {
      // Students can create an application for themselves
      allow create: if isSignedIn() && request.resource.data.email.toLowerCase() == getUserEmail();
      // Students can view/update only their own application; Admins can view/update all
      allow read, update: if isAdmin() || (isSignedIn() && resource.data.email.toLowerCase() == getUserEmail());
      // Only admins can delete applications
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------
    // 2. STUDENT PROFILES COLLECTION (Keyed by student email)
    // -------------------------------------------------------------
    match /profiles/{email} {
      // Students can manage their own profile; Admins can inspect/manage all
      allow read, write: if isAdmin() || isOwner(email);
    }

    // -------------------------------------------------------------
    // 3. ADMIN USERS & ASSISTANTS COLLECTION
    // -------------------------------------------------------------
    match /admin_users/{email} {
      // Authenticated users can read admin user list to verify authority
      allow read: if isSignedIn();
      // Only authorized admins can create, update, or revoke staff/assistant accounts
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------
    // 4. SITE CONTENT & SETTINGS (CMS)
    // -------------------------------------------------------------
    match /site_settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /site_content/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------
    // 5. ACADEMIC PROGRAMS CATALOG
    // -------------------------------------------------------------
    match /programs/{progId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------
    // DEFAULT DENY ALL OTHER COLLECTIONS & DOCUMENTS
    // -------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
