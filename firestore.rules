rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if request comes from an authenticated user
    function isSignedIn() {
      return request.auth != null;
    }

    // -------------------------------------------------------------
    // 1. APPLICATIONS COLLECTION (Admissions)
    // -------------------------------------------------------------
    match /applications/{appId} {
      allow read, create, update, delete: if isSignedIn();
    }

    // -------------------------------------------------------------
    // 2. STUDENT PROFILES COLLECTION
    // -------------------------------------------------------------
    match /profiles/{email} {
      allow read, write: if isSignedIn();
    }

    // -------------------------------------------------------------
    // 3. ADMIN USERS & ASSISTANTS COLLECTION
    // -------------------------------------------------------------
    match /admin_users/{email} {
      allow read, write: if isSignedIn();
    }

    // -------------------------------------------------------------
    // 4. SITE SETTINGS & CONTENT (CMS)
    // -------------------------------------------------------------
    match /site_settings/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    match /site_content/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // -------------------------------------------------------------
    // 5. ACADEMIC PROGRAMS CATALOG
    // -------------------------------------------------------------
    match /programs/{progId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // -------------------------------------------------------------
    // DEFAULT DENY FOR UNAUTHENTICATED VISITORS ON PRIVATE PATHS
    // -------------------------------------------------------------
    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}
